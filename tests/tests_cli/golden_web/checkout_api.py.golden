# Registry
# -----------------------------------------------------------------------

# 🧩 MemoryStore keeps instances in this process only -- swap in
#    your StateStore (SQLite, Redis, Postgres ...) for production.
registry = StatechartRegistry(MemoryStore())


def register(
    machine: Any, *, authorize: Any = authorize, **kwargs: Any
) -> None:
    """Register *machine* (built from the checkout chart) with `registry`."""
    registry.register(MACHINE_NAME, machine, authorize=authorize, **kwargs)


# -----------------------------------------------------------------------
# Routing plumbing
# -----------------------------------------------------------------------

# 🧱 The library's own route class (what `StatechartRouter` uses):
#    JSON-only bodies bounded by `registry.max_body_bytes` (413 /
#    415 / 408) and 422 problems listing only field location and
#    error type, capped -- never the rejected input (X0.7). It reads
#    the limits HERE: configure `registry` above this line.
router = APIRouter(
    prefix="/checkout",
    tags=["checkout"],
    route_class=bounded_route_class(registry),
)
INSTANCE_ID = Path(..., alias="id")
SEND_RESPONSES: Dict[Any, Any] = {
    200: {"description": "Receipt: state after the event"},
    202: {"description": "Deferred"},
    403: {"description": "Forbidden (authorize)"},
    404: {"description": "Unknown event"},
    409: {"description": "Guard denied / write conflict"},
    422: {"description": "Invalid payload"},
}


def _payload(body: Any) -> Dict[str, Any]:
    if body is None:
        return {}
    if isinstance(body, dict):
        return dict(body)
    return body.model_dump(mode="python", by_alias=True, exclude={"type"})


async def _send(
    request: Request, key: str, event: str, payload: Dict[str, Any]
) -> Response:
    # 🧾 `registry.send_event` is what `StatechartRouter` runs: the
    #    per-event `authorize`, `Idempotency-Key` (400 / 501 / replay
    #    without a save), reserved `send()` keys refused, a denied or
    #    no-op event NOT saved (no version bump, so a concurrent
    #    writer does not lose with 409), problem+json for every
    #    failure. A route of your own that needs the interpreter
    #    itself: `get_interpreter(registry, MACHINE_NAME)` (#279).
    return await registry.send_event(
        request, MACHINE_NAME, key, event, payload
    )


# -----------------------------------------------------------------------
# Routes
# -----------------------------------------------------------------------


@router.get("/{id}", operation_id=f"{MACHINE_NAME}_get", response_model=None)
async def get_state(
    request: Request, instance_id: str = INSTANCE_ID
) -> Response:
    """Current state of a checkout instance"""
    try:
        await registry.authorize(request, MACHINE_NAME, instance_id, None)
        body = await registry.peek(MACHINE_NAME, instance_id)
    except Exception as exc:  # noqa: BLE001 -- mapped, never leaked
        return problem_for_exception(exc)
    return JSONResponse(body)


@router.post(
    "/{id}/events/SUBMIT",
    operation_id=f"{MACHINE_NAME}_submit",
    summary="Send SUBMIT",
    response_model=None,
    responses=SEND_RESPONSES,
)
async def send_submit(
    request: Request,
    instance_id: str = INSTANCE_ID,
    body: Optional[SubmitEvent] = Body(None),
) -> Response:
    """Accepted in: cart."""
    return await _send(request, instance_id, "SUBMIT", _payload(body))


# 📝 Declared LAST: the literal routes above win; anything else is
#    an event this chart does not declare.
@router.post("/{id}/events/{event}", include_in_schema=False)
async def unknown_event(event: str) -> Response:
    return problem(404, "Unknown event")


DECLARED_EVENTS = ["SUBMIT"]
