{
  "name": "done_state_before_queued_external_event",
  "description": "FINISH and NEXT are queued together. Entering the final child raises done.state.work on the INTERNAL queue, so the onDone transition is taken before NEXT is processed and NEXT is handled in after, not in work.",
  "tags": [
    "final",
    "onDone",
    "internal-queue"
  ],
  "machine": {
    "id": "m",
    "initial": "work",
    "states": {
