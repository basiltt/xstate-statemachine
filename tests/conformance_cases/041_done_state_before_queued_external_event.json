        "initial": "step",
        "onDone": {
          "target": "after",
          "actions": "onDoneTaken"
        },
        "on": {
          "NEXT": {
            "actions": "nextInWork"
          }
        },
        "states": {
          "step": {
            "on": {
              "FINISH": "last"
            }
          },
          "last": {
            "type": "final",
            "entry": "enterLast"
          }
        }
      },
      "after": {
        "on": {
          "NEXT": {
            "actions": "nextInAfter"
          }
        }
      }
    }
  },
  "steps": [
    {
      "send_batch": [
        "FINISH",
        "NEXT"
      ]
    }
  ],
