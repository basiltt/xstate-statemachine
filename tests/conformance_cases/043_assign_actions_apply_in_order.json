{
  "name": "assign_actions_apply_in_order",
  "description": "assign actions apply in microstep order -- exit, then each transition action in list order, then entry -- each one seeing what the previous ones wrote. Keys written by more than one assign show the order: a keeps the exit value, b the first transition assign, c the second, d the entry assign. (The JSON dialect has no expressions, so the order in which ONE assign computes its properties, all against the context before it, is pinned by the Python and Rust unit tests.)",
  "tags": [
    "actions",
    "assign",
    "context",
    "entry-exit-order"
  ],
  "machine": {
    "id": "m",
    "initial": "a",
    "context": {
      "a": "init",
      "b": "init",
      "c": "init",
      "d": "init"
    },
    "states": {
      "a": {
        "exit": [
          {
            "type": "assign",
            "params": {
              "assignment": {
                "a": "exit",
                "b": "exit"
              }
            }
          }
        ],
        "on": {
          "GO": {
            "target": "b",
            "actions": [
              {
                "type": "assign",
                "params": {
                  "assignment": {
                    "b": "t1",
                    "c": "t1"
                  }
                }
              },
              "between",
              {
                "type": "assign",
                "params": {
                  "assignment": {
                    "c": "t2",
                    "d": "t2"
                  }
                }
              }
            ]
          }
        }
      },
      "b": {
        "entry": [
          {
            "type": "assign",
            "params": {
              "assignment": {
                "d": "entry"
              }
            }
          },
          "enteredB"
        ]
      }
    }
  },
  "steps": [
    {
      "send": "GO"
    }
  ],
  "expected": {
