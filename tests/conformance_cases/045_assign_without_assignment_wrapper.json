{
  "name": "assign_without_assignment_wrapper",
  "description": "The JSON assign built-in accepts its properties either under params.assignment or directly as params. Two consecutive assigns run in order, the second overwriting what the first wrote.",
  "tags": [
    "actions",
    "assign",
    "context"
  ],
  "machine": {
    "id": "m",
    "initial": "a",
    "context": {
      "count": 0,
      "label": "start"
    },
    "states": {
      "a": {
        "on": {
          "SET": {
            "target": "b",
            "actions": [
              {
                "type": "xstate.assign",
                "params": {
                  "count": 1,
                  "label": "first"
                }
              },
              "between",
              {
                "type": "assign",
                "params": {
                  "label": "second"
                }
              }
            ]
          }
        }
      },
      "b": {
        "entry": [
          {
            "type": "assign",
            "params": {
              "assignment": {
                "count": 2
              }
            }
          },
          {
            "type": "assign",
            "params": {
              "flag": true
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "send": "SET"
    }
  ],
