{
  "name": "choose_and_state_in",
  "description": "The choose built-in runs the first branch whose guard holds; stateIn checks the active configuration; and/or/not compose named guards.",
  "tags": [
    "actions",
    "guards",
    "choose",
    "stateIn"
  ],
  "machine": {
    "id": "m",
    "initial": "p",
    "states": {
      "p": {
        "type": "parallel",
        "states": {
          "mode": {
            "initial": "day",
            "states": {
              "day": {
                "on": {
                  "NIGHT": "night"
                }
              },
              "night": {}
            }
          },
          "work": {
            "initial": "idle",
            "states": {
              "idle": {
                "on": {
                  "PING": {
                    "actions": [
                      {
                        "type": "choose",
                        "params": {
                          "branches": [
                            {
                              "guard": {
                                "type": "stateIn",
                                "params": {
                                  "stateValue": "#m.p.mode.night"
                                }
                              },
                              "actions": "atNight"
                            },
                            {
                              "guard": {
                                "type": "and",
                                "params": {
                                  "guards": [
                                    "isAdmin",
                                    {
                                      "type": "not",
                                      "params": {
                                        "guard": "isBanned"
                                      }
                                    }
                                  ]
                                }
                              },
                              "actions": "adminByDay"
                            },
                            {
                              "actions": "otherwise"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "LOCK": {
                    "target": "locked",
                    "guard": {
                      "type": "or",
                      "params": {
                        "guards": [
                          "isAdmin",
                          "isBanned"
                        ]
                      }
                    }
                  }
                }
              },
              "locked": {}
            }
          }
        }
      }
    }
  },
  "logic": {
    "guards": {
      "isAdmin": true,
      "isBanned": false
    }
  },
  "steps": [
    {
      "send": "PING"
    },
    {
      "send": "NIGHT"
    },
    {
      "send": "PING"
    },
    {
      "send": "LOCK"
    }
  ],
