{
  "name": "always_order_follows_entry_order",
  "description": "XState's selectEventlessTransitions visits the active atomic states in the order the snapshot holds them (snapshot._nodes): the states that remain keep their place and the states a microstep enters are appended, in document order. After F then E, r2's d was entered before r1's b, so d's always is evaluated (and selected) first and preempts b's conflicting one: y wins, although b precedes d in document order. After RESET re-enters p in document order, E then F puts b first and x wins.",
  "tags": [
    "always",
    "parallel",
    "conflict",
    "guards",
    "selection"
  ],
  "machine": {
    "id": "m",
    "initial": "p",
    "on": {
      "RESET": ".p"
    },
    "states": {
      "p": {
        "type": "parallel",
        "states": {
          "r1": {
            "initial": "a",
            "states": {
              "a": {
                "on": {
                  "E": "b"
                }
              },
              "b": {
                "always": {
                  "target": "#m.x",
                  "guard": {
                    "type": "and",
                    "params": {
                      "guards": [
                        "gB",
                        {
                          "type": "stateIn",
                          "params": {
                            "stateValue": "#m.p.r2.d"
                          }
                        }
                      ]
                    }
                  },
                  "actions": "tB"
                }
              }
            }
          },
          "r2": {
            "initial": "c",
            "states": {
              "c": {
                "on": {
                  "F": "d"
                }
              },
              "d": {
                "always": {
                  "target": "#m.y",
                  "guard": {
                    "type": "and",
                    "params": {
                      "guards": [
                        "gD",
                        {
                          "type": "stateIn",
                          "params": {
                            "stateValue": "#m.p.r1.b"
                          }
                        }
                      ]
                    }
                  },
                  "actions": "tD"
                }
              }
            }
          }
        }
      },
      "x": {
        "entry": "e_x"
      },
      "y": {
        "entry": "e_y"
      }
    }
  },
  "logic": {
    "record_guards": true
  },
  "steps": [
