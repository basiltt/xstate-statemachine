{
  "name": "history_records_only_on_owner_exit",
  "description": "XState records a history value only when the state that owns the history node is itself exited (exitStates). NEXT and TOK leave states inside s but never s itself, so when k targets s's deep history nothing has been recorded and the history default (s's initial g, then g1) is entered. Once s is exited (OUT), IN restores the configuration recorded at that exit (g2).",
  "tags": [
    "history",
    "deep-history"
  ],
  "machine": {
    "id": "m",
    "initial": "s",
    "states": {
      "s": {
        "initial": "g",
        "on": {
          "OUT": "#m.out"
        },
        "states": {
          "h": {
            "type": "history",
            "history": "deep"
          },
          "g": {
            "initial": "g1",
            "on": {
              "TOK": "k"
            },
            "states": {
              "g1": {
                "entry": "e_g1",
                "on": {
                  "NEXT": "g2"
                }
              },
              "g2": {
                "entry": "e_g2"
              }
            }
          },
          "k": {
            "on": {
              "BACK": "h"
            }
          }
        }
      },
      "out": {
        "on": {
          "IN": "#m.s.h"
        }
      }
    }
  },
  "steps": [
    {
      "send": "NEXT"
    },
    {
      "send": "TOK"
    },
    {
      "send": "BACK"
    },
    {
      "send": "NEXT"
    },
    {
      "send": "OUT"
    },
    {
      "send": "IN"
    }
  ],
