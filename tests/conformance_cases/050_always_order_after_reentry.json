    "id": "m",
    "initial": "p",
    "states": {
      "p": {
        "type": "parallel",
        "states": {
          "r1": {
            "initial": "s",
            "states": {
              "s": {
                "initial": "s1",
                "on": {
                  "RS": {
                    "target": "s",
                    "reenter": true
                  }
                },
                "states": {
                  "h": {
                    "type": "history"
                  },
                  "s1": {
                    "always": {
                      "target": "#m.x",
                      "guard": {
                        "type": "and",
                        "params": {
                          "guards": [
                            "g1",
                            {
                              "type": "stateIn",
                              "params": {
                                "stateValue": "#m.p.r3.armed"
                              }
                            }
                          ]
                        }
                      },
                      "actions": "tX"
                    }
                  }
                }
              }
            }
          },
          "r2": {
            "initial": "t",
            "states": {
              "t": {
                "initial": "t1",
                "on": {
                  "RT": {
                    "target": "t",
                    "reenter": true
                  }
                },
                "states": {
                  "t1": {
                    "always": {
                      "target": "#m.y",
                      "guard": {
                        "type": "and",
                        "params": {
                          "guards": [
                            "g2",
                            {
                              "type": "stateIn",
                              "params": {
                                "stateValue": "#m.p.r3.armed"
                              }
                            }
                          ]
                        }
                      },
                      "actions": "tY"
                    }
                  }
                }
              }
            }
          },
          "r3": {
            "initial": "idle",
            "states": {
              "idle": {
                "on": {
                  "ARM": "armed"
                }
              },
              "armed": {}
            }
          }
        }
      },
      "x": {
        "entry": "e_x",
        "on": {
          "BACK": "#m.p"
        }
      },
      "y": {
        "entry": "e_y",
        "on": {
          "BACK": "#m.p"
        }
      }
    }
  },
  "logic": {
    "record_guards": true
  },
  "steps": [
