{
  "name": "guard_and_assign",
  "description": "Named guard refuses; JSON-form assign writes static values; payload travels with the event. Guards are constants in the oracles, so UNLOCK changes context but the guard stays false and OPEN is still refused.",
  "tags": [
    "guards",
    "assign",
    "context"
  ],
  "machine": {
    "id": "door",
    "initial": "closed",
    "context": {
      "opens": 0,
      "locked": true
    },
    "states": {
      "closed": {
        "on": {
          "UNLOCK": {
            "actions": {
              "type": "assign",
              "params": {
                "assignment": {
                  "locked": false
                }
              }
            }
          },
          "OPEN": {
            "target": "opened",
            "guard": "isUnlocked",
            "actions": [
              "countOpen",
              {
                "type": "assign",
                "params": {
                  "assignment": {
                    "opens": 1
                  }
                }
              }
            ]
          }
        }
      },
      "opened": {
        "on": {
          "CLOSE": "closed"
        }
      }
    }
  },
  "logic": {
    "guards": {
      "isUnlocked": false
    }
  },
  "steps": [
    {
      "send": "OPEN"
    },
    {
      "send": "UNLOCK"
    },
    {
      "send": {
        "type": "OPEN",
        "by": "ada"
      }
    }
  ],
