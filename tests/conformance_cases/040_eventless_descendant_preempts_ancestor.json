{
  "name": "eventless_descendant_preempts_ancestor",
  "description": "After GO both the parallel state p (guarded by stateIn r2.c) and the leaf c have an enabled always transition. p's is selected first (r1's leaf walks up to it) but c is a descendant of p, so c's transition preempts it (removeConflictingTransitions). On the next eventless pass p's guard no longer holds.",
  "tags": [
    "parallel",
    "conflict",
    "always",
    "microstep"
  ],
  "machine": {
    "id": "m",
    "initial": "p",
    "states": {
      "p": {
        "type": "parallel",
        "always": {
          "target": "#m.out",
          "guard": {
            "type": "stateIn",
            "params": {
              "stateValue": "#m.p.r2.c"
            }
          },
          "actions": "tp"
        },
        "states": {
          "r1": {
            "initial": "a",
            "states": {
              "a": {}
            }
          },
          "r2": {
            "initial": "b",
            "states": {
              "b": {
                "on": {
                  "GO": "c"
                }
              },
              "c": {
                "exit": "x_c",
                "always": {
                  "target": "d",
                  "actions": "tc"
                }
              },
              "d": {
                "entry": "e_d"
              }
            }
          }
        }
      },
      "out": {
        "entry": "e_out"
      }
    }
  },
  "steps": [
    {
      "send": "GO"
    }
  ],
