{
  "name": "always_transitions",
  "description": "Eventless transitions settle after each event; the first enabled always branch wins.",
  "tags": [
    "always",
    "eventless",
    "guards"
  ],
  "machine": {
    "id": "triage",
    "initial": "idle",
    "states": {
      "idle": {
        "on": {
          "SUBMIT": "checking"
        }
      },
      "checking": {
        "entry": "startCheck",
        "always": [
          {
            "target": "rejected",
            "guard": "isBlocked"
          },
          {
            "target": "approved",
            "guard": "isTrusted"
          },
          {
            "target": "review"
          }
        ]
      },
      "approved": {
        "type": "final"
      },
      "rejected": {
        "type": "final"
      },
      "review": {
        "on": {
          "APPROVE": "approved"
        }
      }
    }
  },
  "logic": {
    "guards": {
      "isBlocked": false,
      "isTrusted": false
    }
  },
  "steps": [
    {
      "send": "SUBMIT"
    },
    {
      "send": "APPROVE"
    }
  ],
