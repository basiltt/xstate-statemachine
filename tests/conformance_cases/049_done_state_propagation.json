                        }
                      },
                      "yf": {
                        "type": "final"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "after": {
        "entry": "e_after",
        "on": {
          "NEST": "#m.a"
        }
      },
      "a": {
        "initial": "b",
        "onDone": {
          "actions": "aDone"
        },
        "states": {
          "b": {
            "initial": "c",
            "states": {
              "c": {
                "on": {
                  "FIN": "f"
                }
              },
              "f": {
                "type": "final"
              }
            }
          }
        }
      }
    }
  },
